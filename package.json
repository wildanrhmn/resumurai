{
  "name": "resumurai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Resumurai — an OKX.AI ASP that slices your resume to cut through the ATS. Paste resume + job description -> ATS score, gap analysis, and a real ATS-safe .docx/.pdf resume + cover letter.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:web": "npm --prefix web install && npm --prefix web run build",
    "build:all": "npm run build:web && npm run build",
    "start": "node dist/index.js",
    "gen:demo-cache": "tsx scripts/gen-demo-cache.ts src/demo/demo-cache.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@okxweb3/x402-core": "^0.1.0",
    "@okxweb3/x402-evm": "^0.2.1",
    "@okxweb3/x402-express": "^0.1.1",
    "docx": "^9.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mammoth": "^1.9.0",
    "pdfkit": "^0.15.1",
    "unpdf": "^1.8.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.13.9",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
