# ─── Resumurai config (copy to .env) ───────────────────────────────────────

# Claude (engine)
ANTHROPIC_API_KEY=sk-ant-...
MODEL=claude-sonnet-5
# cheaper model for parsing resume/JD files (OCR/transcription of PDFs)
OCR_MODEL=claude-haiku-4-5

# Server
PORT=8792

# ─── Payments (x402 / OKX A2MCP) ───────────────────────────────────────────
# Leave PAYMENTS_ENABLED=false in dev; the paid endpoint then runs open.
PAYMENTS_ENABLED=false
PAY_TO_ADDRESS=            # OKX Agentic Wallet address (X Layer). Same as Scaminja: 0x4eb6...993a
PRICE=0.03                 # USDT per call (plain number)
MAX_TIMEOUT_SECONDS=120
OKX_BASE_URL=https://web3.okx.com
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# ─── Limits & protection ───────────────────────────────────────────────────
# Paid callers cover their own cost -> lenient. Free /try spends OUR balance -> tight.
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=20
RATE_LIMIT_GLOBAL_MAX=200
DEMO_RATE_MAX=5
DEMO_RATE_GLOBAL_MAX=40
DAILY_FREE_MAX=400         # hard daily kill-switch on free /try calls

# Input caps
MAX_TEXT_CHARS=60000       # per field (resume / jd)
MAX_FILE_BYTES=6000000     # ~6 MB per uploaded resume file
MAX_FILES=2

# Engine
ANALYZE_TIMEOUT_MS=90000
BREAKER_COOLDOWN_MS=120000

# ─── Evidence layer (optional external sources) ────────────────────────────
# LanguageTool grammar/spell check. Default = free public API (20 req/min per IP).
# For production, self-host and point here: docker run -d -p 8081:8010 languagetool/languagetool
LANGUAGETOOL_URL=          # e.g. http://localhost:8081/v2/check  (blank = public API)
# O*NET authoritative role tech-skills. Free key: services.onetcenter.org/developer/signup
# Blank = the O*NET evidence line is simply omitted (the rest of the layer still runs).
ONET_API_KEY=

# Artifacts
ARTIFACT_TTL_MS=1800000    # 30 min download links
